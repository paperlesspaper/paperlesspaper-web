# syntax=docker/dockerfile:1
FROM node:24.11.0-slim AS build
WORKDIR /build
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update -qq && apt-get install --no-install-recommends -y git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY tools/paperlesspaper-renderer/package*.json ./
RUN npm ci
COPY tools/paperlesspaper-renderer/main.ts ./tools/paperlesspaper-renderer/main.ts
COPY packages/paperlesspaper-api/src/render ./packages/paperlesspaper-api/src/render
COPY packages/helpers/src/deviceList.ts ./packages/helpers/src/deviceList.ts
RUN ./node_modules/.bin/esbuild tools/paperlesspaper-renderer/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --alias:@paperlesspaper/helpers=./packages/helpers/src/deviceList.ts --outfile=dist/main.mjs && npm prune --omit=dev

FROM node:24.11.0-slim
ENV NODE_ENV=production CHROME_BIN=/usr/bin/chromium-headless-shell PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update -qq && apt-get install --no-install-recommends -y chromium-headless-shell chromium-sandbox tini ca-certificates && rm -rf /var/lib/apt/lists/* && mkdir -p /run/paperlesspaper-renderer && chown node:node /run/paperlesspaper-renderer && chmod 700 /run/paperlesspaper-renderer
WORKDIR /app
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/dist ./dist
USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 CMD node -e "require('http').get({socketPath:'/run/paperlesspaper-renderer/renderer.sock',path:'/health'},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/main.mjs"]
