MONITOR_ENVIRONMENT=production
SLIDESHOW_SNAPSHOT_URL=https://api.paperlesspaper.de/v1/monitor/slideshows
# Dedicated random secret, >=32 characters, also configured on the API.
SLIDESHOW_MONITOR_TOKEN=
ADMIN_MONITOR_INGEST_URL=https://admin.paperlesspaper.de/api/admin/live-monitor/runs
# Matches the existing LIVE_MONITOR_INGEST_TOKEN on the Admin deployment.
ADMIN_MONITOR_INGEST_TOKEN=
CHECK_INTERVAL_SECONDS=120
SCAN_TIMEOUT_SECONDS=300
GRACE_SECONDS=300
FAILURE_REMINDER_HOURS=6
# Optional JSON receiver for incident/recovery events. No notifications without a configured receiver.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
# Optional external dead-man switch. Never host this check on the monitored server itself.
MONITOR_HEARTBEAT_URL=
STATE_FILE=/data/slideshows.json
